# Robinhood Chain EVM JSON-RPC endpoints
RPC_HTTP_URL=
# Use an Alchemy/QuickNode/dRPC JSON-RPC WebSocket URL here. The public RPC root is HTTP-only.
RPC_WS_URL=

# Pons V2 mothership proxy
MOTHERSHIP_ADDRESS=0x6bed168687c1bca3466f1f3fb188c2dd058f4597

# Enable this to discover candidate wallets from successful mothership bundle transactions.
MOTHERSHIP_DISCOVERY_ENABLED=false
# Candidate wallets expire after this many milliseconds unless refreshed.
CANDIDATE_TTL_MS=604800000
# Optional comma-separated wallets to monitor immediately after startup.
INITIAL_CANDIDATE_WALLETS=

# Launch calldata exemption gate.
MIN_EXEMPTIONS=25
MAX_EXEMPTIONS=32

# Buy execution switches. Set BUY_PLAN=true and BUY_EXECUTE=true only when ready.
BUY_PLAN=false
BUY_EXECUTE=false
BUY_ENABLED=false
BUY_RECIPIENT=
# Accepts decimal native currency (recommended) or an integer wei value.
BUY_AMOUNT_WEI=0.00002
# Delay after launch detection before requesting the GMGN buy.
BUY_POST_LAUNCH_DELAY_MS=800
BUY_EXECUTION_MODE=gmgn_agent_swap
GMGN_API_KEY=
# Matching PEM private key for the public key registered with GMGN; never commit or share it.
GMGN_PRIVATE_KEY=
# Or store the PEM in this local ignored file.
GMGN_PRIVATE_KEY_FILE=./GMGN_PRIVATE_KEY_FILE
GMGN_SLIPPAGE_PERCENT=15

# Optional Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
