# Robinhood Chain EVM JSON-RPC endpoints
RPC_HTTP_URL=https://rpc.mainnet.chain.robinhood.com
# Use an Alchemy/QuickNode/dRPC JSON-RPC WebSocket URL here. The public RPC root is HTTP-only.
RPC_WS_URL=

# Pons V2 mothership proxy
MOTHERSHIP_ADDRESS=0x6bed168687c1bca3466f1f3fb188c2dd058f4597

# The known BundleCreated event topic observed on the mothership.
BUNDLE_CREATED_TOPIC=0x1cc27e421486e19dd9942a7d534956723c7b40410db99dea6c2be261d16ccae2

# Candidate wallets expire after this many milliseconds unless refreshed.
CANDIDATE_TTL_MS=900000

# Safety: detection only by default. Do not enable until execution is reviewed.
BUY_ENABLED=false
BUY_RECIPIENT=
BUY_AMOUNT_WEI=800000000000000
BUY_EXECUTION_MODE=gmgn_unsigned_tx
GMGN_API_KEY=
GMGN_SLIPPAGE_PERCENT=15
